<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" minWidth="-Infinity" prefHeight="320.0" prefWidth="500.0" spacing="20.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.dipezak.adeiesgui.PrimaryController">
    <children>
        <!-- HBox for the label and spinner aligned to the top-right -->
        <HBox alignment="CENTER_RIGHT" prefWidth="500.0">
            <!-- Spacer to push the content to the right -->
            <Region HBox.hgrow="ALWAYS" />
            
            <!-- Label for "Σχολικό έτος" -->
            <Label stylesheets="@style.css" text="Σχολικό έτος" >
                <font>
                    <Font name="System Bold" size="12.0" />
                </font>
            </Label>
            
            <!-- Spinner with default value -->
            <Spinner fx:id="spinnerControl" prefWidth="120.0" />
        </HBox>

        <!-- Label for CSV selection -->
        <Label stylesheets="@style.css" text="Επιλέξτε αρχεία CSV">
            <font>
                <Font name="System Bold" size="12.0" />
            </font>
        </Label>

        <!-- GridPane for buttons and icons -->
        <GridPane alignment="CENTER" prefHeight="100.0" prefWidth="350.0" hgap="20.0" vgap="10.0">
            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="100.0" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="30.0" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="100.0" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="30.0" />
            </columnConstraints>
            <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="40.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="40.0" vgrow="SOMETIMES" />
            </rowConstraints>
            <children>
                <!-- Payroll CSV Button -->
                <Button fx:id="payrollButton" onAction="#payrollButtonClicked" styleClass="button-glass-grey" stylesheets="@style.css" text="Payroll CSV" GridPane.halignment="RIGHT">
                    <tooltip>
                        <Tooltip fx:id="payrollButtonTooltip" text="Για να κατεβάσετε το Payroll CSV πατήστε Μισθοδοσία - Άδεια - Μαζική εξαγωγή σε CSV" textAlignment="JUSTIFY" width="100.0" wrapText="true">
                            <font>
                                <Font size="13.0" />
                            </font>
                        </Tooltip>
                    </tooltip>
                </Button>
                <!-- Payroll Check Icon -->
                <ImageView fx:id="check1" fitHeight="20.0" fitWidth="20.0" visible="false" GridPane.columnIndex="1" GridPane.halignment="LEFT">
                    <image>
                        <Image url="@check_icon.png" />
                    </image>
                </ImageView>
                <!-- MySchool CSV Button -->
                <Button fx:id="mySchoolButton" onAction="#mySchoolButtonClicked" styleClass="button-glass-grey" text="MySchool CSV" GridPane.columnIndex="2" GridPane.halignment="RIGHT">
                    <tooltip>
                        <Tooltip fx:id="mySchoolButtonTooltip" maxWidth="400" text="Για να κατεβάσετε το MySchool CSV πατήστε Στατιστικά - 4. Στατιστικά Εκπαιδευτικών - 21. Άδειες (πλην Άνευ Αποδοχών). Στη συνέχεια επιλέγετε τα τρέχοντα έτη, όλες τις άδειες, πατάτε Αναζήτηση και Εξαγωγή." textAlignment="JUSTIFY" width="100.0" wrapText="true">
                            <font>
                                <Font size="13.0" />
                            </font>
                        </Tooltip>
                    </tooltip>
                </Button>
                <!-- MySchool Check Icon -->
                <ImageView fx:id="check2" fitHeight="20.0" fitWidth="20.0" visible="false" GridPane.columnIndex="3" GridPane.halignment="LEFT">
                    <image>
                        <Image url="@check_icon.png" />
                    </image>
                </ImageView>
            </children>
        </GridPane>
        <!-- Compare Button -->
        <Button fx:id="compareButton" disable="true" onAction="#compareButtonClicked" styleClass="button-glass-grey" stylesheets="@style.css" text="Σύγκριση" GridPane.columnSpan="4" GridPane.halignment="CENTER" GridPane.rowIndex="1" /> 
        <!-- Αριθμός αναρρωτικών Button -->
        <Button fx:id="numberButton" disable="true" onAction="#numberButtonClicked" styleClass="button-glass-grey" text="Αριθμός αναρρωτικών" />
        <!-- Error Label (hidden by default) -->
        <Label fx:id="errorLabel" text="Label" visible="false" />
    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <stylesheets>
        <URL value="@style.css" />
    </stylesheets>
</VBox>
